# Python
backend/.venv/
backend/__pycache__/
*.pyc
*.pyo

# Environment（只忽略根目录含密钥的 .env，frontend/.env 为公开前端配置）
/.env

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker volumes (don't track)
mysql_data/
redis_data/

# 本地持久化数据（数据库文件 + 模型，共 ~2GB）
data/

# Logs
*.log
tmp/
.runtime/

# Frontend
frontend/node_modules/
frontend/dist/

# Playwright browsers
ms-playwright/

# 扫码登录状态包含 Cookie、Token 和设备信息，只允许保存在本机
backend/storage_state/*.json

# DataEase 外部配置
# DataEase 运行目录默认忽略，但保留启动必需的配置文件，避免换电脑后挂载成同名目录。
dataease/*
!dataease/conf/
dataease/conf/*
!dataease/conf/application.yml
.coverage

# Claude Code generated files
.claude/

# Reasonix 工具配置与运行目录
.reasonix/
reasonix.toml
