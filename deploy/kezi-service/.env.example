# 服务只监听本机，由 Nginx 通过 HTTPS 反向代理
KEZI_HOST=127.0.0.1
# 客资服务内部端口
KEZI_PORT=3001

# 客资 MySQL 地址
KEZI_DB_HOST=127.0.0.1
# 客资 MySQL 端口
KEZI_DB_PORT=3306
# 客资 MySQL 用户名
KEZI_DB_USER=请替换为客资数据库用户
# 客资 MySQL 密码
KEZI_DB_PASSWORD=请替换为随机强密码
# 客资 MySQL 数据库名
KEZI_DB_NAME=kezi

# 写入接口专用密钥，给采集来源使用，至少 32 位随机字符串
KEZI_WRITE_TOKEN=请替换为至少32位随机字符串
# 拉取和统计接口专用密钥，只放在本项目后端 .env，至少 32 位随机字符串
KEZI_READ_TOKEN=请替换为另一条至少32位随机字符串
